PORT=4000
NODE_ENV=development

# MongoDB Atlas connection string (Database > Connect > Drivers). Include the database name before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/threadsandgems?retryWrites=true&w=majority

# Websites allowed to call this API (comma separated, no trailing slashes): storefront and admin
CORS_ORIGINS=http://localhost:3000,http://localhost:3001

# Clerk: same application as the storefront and admin
CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Stripe
STRIPE_SECRET_KEY=sk_test_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Cloudinary (Dashboard > API Keys)
CLOUDINARY_CLOUD_NAME=xxx
CLOUDINARY_API_KEY=xxx
CLOUDINARY_API_SECRET=xxx
CLOUDINARY_FOLDER=threadsandgems/products
